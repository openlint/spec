<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <title>[TITLE]</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <style data-fill-with="stylesheet"></style>
</head>
<body class="h-entry">
<div class="head">
  <p><a href="https://openlint.org/"><img class="logo" src="[LOGO]" alt="OpenLint" width="64" height="64" style="border-radius: 12px"></a></p>
  <h1 id="title" class="p-name no-ref">[TITLE]</h1>
  <h2 id="profile-and-date" class="no-num no-toc no-ref">[VERSIONLABEL], <time class="dt-updated" datetime="[ISODATE]">[DATE]</time></h2>
  <div data-fill-with="spec-metadata"></div>
  <div data-fill-with="warning"></div>
  <p class='copyright' data-fill-with='copyright'></p>
  <hr title="Separator for header">
</div>
<div class="p-summary" data-fill-with="abstract"></div>
